---
import {brand,cities} from '../data/cities';
interface Props { base?:string }
const {base=''}=Astro.props;
const countyGroups=cities.reduce<Record<string,typeof cities>>((acc,c)=>{(acc[c.county] ||= []).push(c);return acc},{});
const countyEntries=Object.entries(countyGroups);
const perCol=Math.ceil(countyEntries.length/4);
const countyCols=Array.from({length:4},(_,i)=>countyEntries.slice(i*perCol,(i+1)*perCol));
---
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header"><div class="container site-header__inner"><a class="brand" href="/" aria-label={`${brand} home`}><svg viewBox="0 0 42 42" width="38" height="38" aria-hidden="true"><path d="M6 32V19L21 9l15 10v13" fill="none" stroke="currentColor" stroke-width="2"/><path d="M13 32l7-8 5 4 5-11" fill="none" stroke="currentColor" stroke-width="2.3"/><circle cx="30" cy="17" r="2" fill="currentColor"/></svg><span>Tucson<br/>Fix & Flip Loan</span></a><button class="site-header__toggle" type="button" aria-label="Toggle menu" aria-controls="site-nav" aria-expanded="false"><svg class="mobile-menu-hamburger" aria-hidden="true" focusable="false" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg><svg class="mobile-menu-x" aria-hidden="true" focusable="false" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m6 6 12 12M18 6 6 18"/></svg></button><nav class="site-nav" id="site-nav" aria-label="Main"><a href="/#how-it-works">How it works</a><a href="/#why-us">Our approach</a><a href="/#faq">FAQ</a><div class="site-nav__dropdown"><button class="site-nav__dropdown-trigger" type="button" aria-expanded="false" aria-controls="service-area-menu">Service areas <span aria-hidden="true">⌄</span></button><div class="site-nav__dropdown-menu" id="service-area-menu"><div class="site-nav__counties">{countyCols.map(col=><div class="site-nav__county-col">{col.map(([county,list])=><div class="site-nav__county"><p>{county} County</p>{list.map(c=><a href={`/${c.slug}/`}>{c.name}</a>)}</div>)}</div>)}</div></div></div><a class="btn site-nav__cta" href={`${base}#deal-form`}>Submit a project <span aria-hidden="true">↗</span></a></nav></div></header>
<script is:inline>
(function(){var toggle=document.querySelector('.site-header__toggle'),nav=document.getElementById('site-nav'),dd=document.querySelector('.site-nav__dropdown'),dt=dd.querySelector('button');toggle.addEventListener('click',function(){var open=toggle.getAttribute('aria-expanded')==='true';toggle.setAttribute('aria-expanded',String(!open));nav.classList.toggle('is-open',!open)});dt.addEventListener('click',function(){var open=dt.getAttribute('aria-expanded')==='true';dt.setAttribute('aria-expanded',String(!open));dd.classList.toggle('is-open',!open)});document.addEventListener('click',function(e){if(!dd.contains(e.target)){dd.classList.remove('is-open');dt.setAttribute('aria-expanded','false')}})})();
</script>
<style is:global>
/* Mobile menu: hamburger/X icons (no box), open menu above the sticky call/deal button. */
.site-header__toggle{color:var(--plum);border:0!important;background:none!important;box-shadow:none!important;padding:10px;min-width:44px;min-height:44px;align-items:center;justify-content:center}
.site-header__toggle .mobile-menu-x{display:none}
.site-header__toggle[aria-expanded="true"] .mobile-menu-hamburger{display:none}
.site-header__toggle[aria-expanded="true"] .mobile-menu-x{display:block}
.site-header__toggle .mobile-menu-hamburger,.site-header__toggle .mobile-menu-x{flex:none}
.site-header__toggle:focus-visible{outline:2px solid currentColor;outline-offset:2px}
@media(max-width:1100px){.site-header:has(.site-header__toggle[aria-expanded="true"]){z-index:2001}}
</style>
