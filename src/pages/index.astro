---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CityContent from '../components/CityContent.astro';
import {getLoanTerms} from '../data/loanTerms';
import {brand,domain,cities} from '../data/cities';
const title='Fix and Flip Loans in Tucson, AZ | Tucson Fix & Flip Loan';
const loanTerms = await getLoanTerms();
const description='Connect with potential fix and flip loan options for Tucson-area investment properties. Share your purchase and renovation plan for a project-specific review.';
const businessId=`https://${domain}/#business`;
const faq=[{q:'Are you the lender?',a:'No. We connect investors with one lending partner. Our lending partner determines eligibility and terms.'},{q:'Does submitting guarantee funding?',a:'No. A submission starts a review, not an approval or commitment.'}];
const jsonld=[{'@context':'https://schema.org','@type':'WebSite',name:brand,url:`https://${domain}/`},{'@context':'https://schema.org','@type':'FinancialService','@id':businessId,name:brand,url:`https://${domain}/`,areaServed:cities.map(c=>({'@type':'City',name:c.name,containedInPlace:{'@type':'State',name:'Arizona'}})),description:'Fix and flip funding connections for real estate investors across metro Tucson. Not a direct lender.'},{'@context':'https://schema.org','@type':'Service',serviceType:'Fix and flip loan connection service',provider:{'@id':businessId},areaServed:cities.map(c=>({'@type':'City',name:c.name,containedInPlace:{'@type':'State',name:'Arizona'}}))},{'@context':'https://schema.org','@type':'FAQPage',mainEntity:faq.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))}];
---
<Base title={title} description={description} path="/" jsonld={jsonld}><Header/><main><CityContent cityName="Tucson Metro" location="Homepage" intro="Asset-based fix and flip funding starts with the Tucson-area property and its renovation plan. Tell us about the home, the work you plan and how you expect to sell it. Tucson Fix & Flip Loan helps connect investors with one lending partner; we do not lend directly." angle="An older central Tucson home, a Marana subdivision house and a Sahuarita property call for different repair scopes. Start with the actual condition, intended work and nearby finished-home sales." caution="A strong listing photo cannot tell you whether the repair budget works. Check the scope and discuss the actual project with a funding partner before relying on any possible terms." showCityGrid={true} loanTerms={loanTerms}/></main><Footer/></Base>
